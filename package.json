{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:spec": "astro build && vitest run --config vitest.config.ts",
    "test": "pnpm test:unit && pnpm test:spec",
    "db:generate": "drizzle-kit generate",
    "cleanup:zombies": "tsx scripts/cleanup-zombie-players.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/node": "^11.1.6",
    "astro": "^7.3.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.1.0",
    "tsx": "4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  }
}
