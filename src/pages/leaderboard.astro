---
import { type LeaderboardEntry, listLeaderboard, parseLeaderboardQuery } from "../lib/db";
import { getExistingPlayer } from "../lib/session";
import "../styles.css";

// Server-rendered from the database on every request — a refresh re-queries
// rather than reading anything cached in the page or the browser, which is
// what "survives a refresh" actually requires. Search/filtering is just the
// request's own query string, read and validated here with the same
// parseLeaderboardQuery the JSON API uses, so a GET form submit is all the
// client-side code search needs.
const rawParams = Astro.url.searchParams;
const parsed = parseLeaderboardQuery(rawParams);
const currentPlayer = getExistingPlayer(Astro.cookies);

const fieldValue = (name: string): string => rawParams.get(name) ?? "";
// Only player/from/to actually narrow the result set — sort just reorders
// it — so only those three decide the empty-state wording below.
const hasFilters = ["player", "from", "to"].some((name) => fieldValue(name) !== "");
const sortValue = fieldValue("sort") === "asc" ? "asc" : "desc";
// Anything set, sort included, is enough to show "Clear" — reset means back
// to the plain default view.
const hasAnyQueryParam = hasFilters || sortValue !== "desc";

let entries: LeaderboardEntry[] = [];
let errors: string[] = [];
if (parsed.ok) {
  entries = listLeaderboard({ ...parsed.filters, limit: 10, currentPlayerId: currentPlayer?.id ?? null });
} else {
  errors = parsed.errors;
}

function formatDuration(ms: number): string {
  const totalSeconds = Math.round(ms / 1000);
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return minutes > 0 ? `${minutes}m ${seconds}s` : `${seconds}s`;
}

// Fixed English Y-M-D formatting, built by hand rather than
// toLocaleString(), so "Finished" can't drift from the YYYY-MM-DD the date
// filters use (toLocaleString("en-AU") reads DD/MM/YYYY, easy to misread
// next to a YYYY-MM-DD filter). Doesn't change what instant is stored or
// compared — only how it's displayed.
function formatFinishedAt(iso: string): string {
  const d = new Date(iso);
  const pad = (n: number): string => String(n).padStart(2, "0");
  const date = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  const time = `${pad(d.getHours())}:${pad(d.getMinutes())}`;
  return `${date} ${time}`;
}

const today = new Date().toISOString().slice(0, 10);
const todayParams = new URLSearchParams(rawParams);
todayParams.set("from", today);
todayParams.set("to", today);
const todayHref = `/leaderboard/?${todayParams.toString()}`;

const activeFilters = [
  fieldValue("player") && `player contains "${fieldValue("player")}"`,
  fieldValue("from") && `finished on/after ${fieldValue("from")}`,
  fieldValue("to") && `finished on/before ${fieldValue("to")}`,
  sortValue === "asc" && "lowest score first",
].filter((part): part is string => Boolean(part));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Leaderboard — Snake Arena</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Snake Arena</a>
      <a href="/play/">Play</a>
      <a href="/leaderboard/">Leaderboard</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Leaderboard</h1>
      <p>Top {entries.length > 0 ? entries.length : "0"} players, ranked by personal best score.</p>

      <form method="get" class="leaderboard-filters" aria-label="Search leaderboard">
        <div class="filter-field">
          <label for="player">Player</label>
          <input type="search" id="player" name="player" placeholder="e.g. 5D2C" value={fieldValue("player")} />
        </div>
        <div class="filter-field">
          <label for="sort">Sort by</label>
          <select id="sort" name="sort">
            <option value="desc" selected={sortValue === "desc"}>Highest score first</option>
            <option value="asc" selected={sortValue === "asc"}>Lowest score first</option>
          </select>
        </div>
        <div class="filter-field">
          <label for="from">From</label>
          <input type="date" id="from" name="from" value={fieldValue("from")} />
        </div>
        <div class="filter-field">
          <label for="to">To</label>
          <input type="date" id="to" name="to" value={fieldValue("to")} />
        </div>
        <div class="filter-actions">
          <button class="button primary" type="submit">Search</button>
          <a class="button" href={todayHref}>Today</a>
          {hasAnyQueryParam && (
            <a class="button" href="/leaderboard/">
              Clear
            </a>
          )}
        </div>
      </form>
      <p class="filters-note">Dates use YYYY-MM-DD (UTC). Player search matches part of a name.</p>
      {activeFilters.length > 0 && errors.length === 0 && (
        <p class="active-filters">Filtering by: {activeFilters.join(", ")}.</p>
      )}

      {
        errors.length > 0 && (
          <div class="panel" role="alert">
            <p>That search couldn't be run:</p>
            <ul>
              {errors.map((message) => (
                <li>{message}</li>
              ))}
            </ul>
          </div>
        )
      }

      <p id="leaderboard-status" role="status"></p>

      {
        errors.length === 0 && entries.length === 0 && hasFilters && (
          <p class="panel">No players match your search.</p>
        )
      }
      {
        errors.length === 0 && entries.length === 0 && !hasFilters && (
          <p class="panel">
            No games finished yet — <a href="/play/">play one</a>.
          </p>
        )
      }

      {
        errors.length === 0 && entries.length > 0 && (
          <table>
            <caption class="sr-only">Snake Arena leaderboard</caption>
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Player</th>
                <th scope="col">Score</th>
                <th scope="col">Survived</th>
                <th scope="col">Finished</th>
                <th scope="col">Action</th>
              </tr>
            </thead>
            <tbody>
              {entries.map((entry, index) => (
                <tr class={entry.isMine ? "mine" : undefined}>
                  <td class="rank">{index + 1}</td>
                  <td data-label="Player">
                    <span class="cell-value">
                      {entry.displayName}
                      {entry.isMine && <span class="you-badge">YOU</span>}
                    </span>
                  </td>
                  <td data-label="Score">
                    <span class="cell-value">{entry.score}</span>
                  </td>
                  <td data-label="Survived">
                    <span class="cell-value">{formatDuration(entry.survivalTimeMs)}</span>
                  </td>
                  <td data-label="Finished">
                    <span class="cell-value">{formatFinishedAt(entry.finishedAt)}</span>
                  </td>
                  <td class="row-actions">
                    {entry.isMine && (
                      <button type="button" class="button danger" data-action="delete-me">
                        Delete my data
                      </button>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </main>
    <script>
      const statusEl = document.getElementById("leaderboard-status")!;
      const deleteButton = document.querySelector<HTMLButtonElement>('[data-action="delete-me"]');

      deleteButton?.addEventListener("click", async () => {
        // A native confirm() is a modal the browser itself renders — there's
        // no custom dialog component in this app to use instead, and this is
        // exactly the kind of irreversible action that calls for one.
        const confirmed = confirm(
          "Delete all your game data permanently?\n\n" +
            "All of your scores and game history associated with this anonymous " +
            "player will be permanently deleted. This action cannot be undone.",
        );
        if (!confirmed) return;

        statusEl.textContent = "Deleting…";
        deleteButton.disabled = true;
        try {
          // Astro's CSRF check only waives form-like content types for
          // same-origin requests without an Origin header; application/json
          // is what marks this as a script-driven call, not a <form> post.
          const res = await fetch("/api/leaderboard/me", {
            method: "DELETE",
            headers: { "content-type": "application/json" },
          });
          if (res.ok) {
            statusEl.textContent = "Your game data has been permanently deleted.";
            window.location.reload();
            return;
          }
          const data = await res.json().catch(() => ({}) as { reason?: string });
          statusEl.textContent = `Couldn't delete your data: ${data.reason ?? res.statusText}`;
        } catch {
          statusEl.textContent = "Couldn't reach the server to delete your data.";
        } finally {
          deleteButton.disabled = false;
        }
      });
    </script>
  </body>
</html>
