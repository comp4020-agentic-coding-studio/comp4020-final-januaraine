---
// The Arena Lobby: the primary entry point for finding and joining rooms
// (see docs/decisions/ADR-002-room-based-multiplayer.md). Server-renders the
// first page of rooms so the lobby isn't blank before JS runs; lobby-client.ts
// then takes over with the live SSE feed, search, pagination, and the
// role-selector dialog.
import { listRooms } from "../lib/db";
import { getOrCreatePlayer } from "../lib/session";
import { getRoomSummary, type RoomSummary } from "../lib/room-server";
import "../styles.css";

const player = getOrCreatePlayer(Astro.cookies);
const initialRooms: RoomSummary[] = listRooms({ limit: 20 })
  .map((row) => getRoomSummary(row.id, player.id))
  .filter((summary): summary is RoomSummary => summary !== null);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light";
      } catch {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Arena — Snake Arena</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Snake Arena</a>
      <a href="/arena/">Arena</a>
      <a href="/leaderboard/">Leaderboard</a>
      <a href="/readme/">About</a>
      <button type="button" class="theme-toggle" data-action="toggle-theme">Light mode</button>
    </nav>
    <main>
      <h1>Arena Lobby</h1>
      <p>Join a room to play or watch, or create your own. Rooms update live as players come and go.</p>

      <div class="lobby-toolbar">
        <label class="lobby-search">
          <span class="sr-only">Search rooms by name</span>
          <input id="room-search" type="search" placeholder="Search rooms by name…" />
        </label>
        <button type="button" class="button primary" data-action="open-create-room">Create Room</button>
      </div>

      <form id="create-room-form" class="panel create-room-form" hidden>
        <h2>Create Room</h2>
        <div class="filter-field">
          <label for="room-name">Room name</label>
          <input id="room-name" name="name" type="text" required maxlength="40" autocomplete="off" />
        </div>
        <label class="checkbox-field">
          <input id="room-locked" name="locked" type="checkbox" />
          Lock player joining (solo play — only you can be a Player)
        </label>
        <label class="checkbox-field">
          <input id="room-allow-viewers" name="allowViewers" type="checkbox" checked />
          Allow public viewers
        </label>
        <p id="create-room-error" class="form-error" role="alert" hidden></p>
        <div class="filter-actions">
          <button type="submit" class="button primary">Create</button>
          <button type="button" class="button" data-action="cancel-create-room">Cancel</button>
        </div>
      </form>

      <p id="rooms-empty" class="panel" hidden>No rooms match your search — create one above.</p>
      <div id="rooms-list" class="rooms-grid" role="list" aria-label="Rooms"></div>

      <div class="lobby-pager">
        <button type="button" id="rooms-prev" class="button" disabled>Previous</button>
        <span id="rooms-page-label">Page 1</span>
        <button type="button" id="rooms-next" class="button">Next</button>
      </div>

      <dialog id="role-dialog" class="role-dialog">
        <h2 id="role-dialog-room-name"></h2>
        <p id="role-dialog-counts"></p>
        <p id="role-dialog-error" class="form-error" role="alert" hidden></p>
        <div class="role-dialog-actions">
          <button type="button" id="join-as-player" class="button primary">Join as Player</button>
          <button type="button" id="join-as-viewer" class="button">Join as Viewer</button>
          <button type="button" id="role-dialog-cancel" class="button">Cancel</button>
        </div>
      </dialog>
    </main>
    <script>
      import { initThemeToggle } from "../frontend/theme";
      initThemeToggle();
    </script>
    <script type="application/json" id="initial-rooms-data" set:html={JSON.stringify(initialRooms)} />
    <script>
      import { initLobby } from "../frontend/lobby-client";
      import type { RoomSummary } from "../lib/room-server";

      const createButton = document.querySelector<HTMLButtonElement>('[data-action="open-create-room"]')!;
      const createForm = document.getElementById("create-room-form") as HTMLFormElement;
      const createError = document.getElementById("create-room-error")!;
      const cancelCreate = document.querySelector<HTMLButtonElement>('[data-action="cancel-create-room"]')!;

      createButton.addEventListener("click", () => {
        createForm.hidden = !createForm.hidden;
      });
      cancelCreate.addEventListener("click", () => {
        createForm.hidden = true;
        createForm.reset();
        createError.hidden = true;
      });

      createForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        createError.hidden = true;
        const data = new FormData(createForm);
        const submitButton = createForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        submitButton.disabled = true;
        try {
          const res = await fetch("/api/rooms", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              name: data.get("name"),
              locked: data.get("locked") === "on",
              allowViewers: data.get("allowViewers") === "on",
            }),
          });
          const body = await res.json();
          if (!res.ok) {
            createError.textContent = body.reason === "name taken" ? "That room name is already taken." : body.reason;
            createError.hidden = false;
            return;
          }
          window.location.href = `/room/${body.roomId}/`;
        } catch {
          createError.textContent = "Couldn't reach the server.";
          createError.hidden = false;
        } finally {
          submitButton.disabled = false;
        }
      });

      initLobby({
        listEl: document.getElementById("rooms-list")!,
        emptyEl: document.getElementById("rooms-empty")!,
        searchInput: document.getElementById("room-search") as HTMLInputElement,
        prevButton: document.getElementById("rooms-prev") as HTMLButtonElement,
        nextButton: document.getElementById("rooms-next") as HTMLButtonElement,
        pageLabel: document.getElementById("rooms-page-label")!,
        dialog: document.getElementById("role-dialog") as HTMLDialogElement,
        dialogRoomName: document.getElementById("role-dialog-room-name")!,
        dialogCounts: document.getElementById("role-dialog-counts")!,
        dialogError: document.getElementById("role-dialog-error")!,
        joinPlayerButton: document.getElementById("join-as-player") as HTMLButtonElement,
        joinViewerButton: document.getElementById("join-as-viewer") as HTMLButtonElement,
        dialogCancelButton: document.getElementById("role-dialog-cancel") as HTMLButtonElement,
        initialRooms: JSON.parse(document.getElementById("initial-rooms-data")!.textContent!) as RoomSummary[],
      });
    </script>
  </body>
</html>
