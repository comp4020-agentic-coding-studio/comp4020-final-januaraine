---
import { getOrCreatePlayer } from "../lib/session";
import "../styles.css";

// Minting the player identity here, server-side, is the backend's "player
// session creation" step for a fresh visitor — by the time the client script
// below runs, the cookie (and the players row behind it) already exists.
const player = getOrCreatePlayer(Astro.cookies);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Play — Snake Arena</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Snake Arena</a>
      <a href="/play/">Play</a>
      <a href="/arena/">Arena</a>
      <a href="/leaderboard/">Leaderboard</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <div class="arena-layout">
        <div class="arena-board">
          <canvas id="board" width="480" height="480" aria-label="Snake Arena game board"></canvas>
          <div class="dpad" role="group" aria-label="Movement controls">
            <div class="dpad-row">
              <button type="button" class="dpad-button" data-direction="up" aria-label="Move up">&uarr;</button>
            </div>
            <div class="dpad-row">
              <button type="button" class="dpad-button" data-direction="left" aria-label="Move left">&larr;</button>
              <button type="button" class="dpad-button" data-direction="down" aria-label="Move down">&darr;</button>
              <button type="button" class="dpad-button" data-direction="right" aria-label="Move right">&rarr;</button>
            </div>
          </div>
        </div>
        <div class="hud">
          <div class="hud-row">
            <span>Player</span>
            <strong id="player-name">{player.displayName}</strong>
          </div>
          <div class="hud-row">
            <span>Score</span>
            <strong id="score">0</strong>
          </div>
          <div class="hud-row">
            <span>Time</span>
            <strong id="timer">0s</strong>
          </div>
          <p id="status-banner" data-status="ready">Press an arrow key or WASD to start</p>
          <button id="restart-button" class="button" type="button">Restart</button>
          <div class="controls-legend">
            <p>
              Move: <kbd>&uarr;</kbd> <kbd>&darr;</kbd> <kbd>&larr;</kbd> <kbd>&rarr;</kbd> or
              <kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd>
            </p>
            <p>Eat the amber dot to grow and score. Don't hit the wall or yourself.</p>
          </div>
          <div id="game-over-panel" class="panel" hidden>
            <h2>Game over</h2>
            <p>Final score: <strong id="final-score">0</strong></p>
            <p id="submit-status" role="status"></p>
            <a class="button" href="/leaderboard/">View leaderboard</a>
          </div>
        </div>
      </div>
    </main>
    <script>
      import { createGameLoop } from "../frontend/loop";
      import { attachDpad } from "../frontend/dpad";
      import { GRID_SIZE, TICK_MS } from "../game/config";
      import type { GameState } from "../game/types";

      const canvas = document.getElementById("board") as HTMLCanvasElement;
      const dpad = document.querySelector<HTMLElement>(".dpad")!;
      const scoreEl = document.getElementById("score")!;
      const timerEl = document.getElementById("timer")!;
      const statusEl = document.getElementById("status-banner")!;
      const restartButton = document.getElementById("restart-button") as HTMLButtonElement;
      const gameOverPanel = document.getElementById("game-over-panel")!;
      const finalScoreEl = document.getElementById("final-score")!;
      const submitStatusEl = document.getElementById("submit-status")!;

      const STATUS_TEXT: Record<GameState["status"], string> = {
        ready: "Press an arrow key or WASD to start",
        playing: "Playing",
        over: "Game over",
      };

      function formatSeconds(ticks: number): string {
        return `${Math.round((ticks * TICK_MS) / 1000)}s`;
      }

      function onStateChange(state: GameState): void {
        scoreEl.textContent = String(state.score);
        timerEl.textContent = formatSeconds(state.ticks);
        statusEl.textContent = STATUS_TEXT[state.status];
        statusEl.dataset.status = state.status;
      }

      async function submitResult(state: GameState): Promise<void> {
        submitStatusEl.textContent = "Saving…";
        try {
          const res = await fetch("/api/games", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ score: state.score, ticks: state.ticks }),
          });
          const data = await res.json();
          submitStatusEl.textContent = res.ok ? "Saved to the leaderboard." : `Not saved: ${data.reason}`;
        } catch {
          submitStatusEl.textContent = "Couldn't reach the server to save this result.";
        }
      }

      function onGameOver(state: GameState): void {
        finalScoreEl.textContent = String(state.score);
        gameOverPanel.hidden = false;
        void submitResult(state);
      }

      const loop = createGameLoop({ canvas, cellPx: canvas.width / GRID_SIZE, onStateChange, onGameOver });
      attachDpad(dpad, (direction) => loop.handleDirection(direction));

      restartButton.addEventListener("click", () => {
        gameOverPanel.hidden = true;
        submitStatusEl.textContent = "";
        loop.restart();
      });
    </script>
  </body>
</html>
