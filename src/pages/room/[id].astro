---
// A single room's game view: canvas, D-pad (Players only), separate
// Players/Viewers membership lists, and one consolidated contextual action
// panel (Become Player/Become Viewer/Respawn — never duplicated). There is
// no `Leave Room` button: leaving a room means navigating away from this
// page, and the Back button plus the departure-signal script below are what
// actually release membership (see docs/decisions/ADR-003 for the
// intentional-departure-vs-disconnection distinction this relies on).
// Membership itself lives only in src/lib/room-server.ts's in-memory
// registry (same place the game state does) — this page reads it directly
// at request time, same process, no extra round trip.
import { getOrCreatePlayer } from "../../lib/session";
import { getMemberRole, getRoomSummary, type RoomSummary } from "../../lib/room-server";
import "../../styles.css";

const roomId = Number(Astro.params.id);
const player = getOrCreatePlayer(Astro.cookies);
const room: RoomSummary | null = Number.isInteger(roomId) ? getRoomSummary(roomId, player.id) : null;
const yourRole = room ? getMemberRole(roomId, player.id) : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light";
      } catch {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{room ? `${room.name} — Snake Arena` : "Room — Snake Arena"}</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/" class="brand">Snake Arena</a>
      <a href="/arena/">Arena</a>
      <a href="/leaderboard/">Leaderboard</a>
      <a href="/readme/">About</a>
      <button type="button" class="theme-toggle" data-action="toggle-theme">Light mode</button>
    </nav>
    <main class="room-page-main">
      {
        !room && (
          <div class="panel" role="alert">
            <h1>Room not found</h1>
            <p>This room doesn't exist, or it has already closed.</p>
            <a class="button primary" href="/arena/">
              Back to the Arena Lobby
            </a>
          </div>
        )
      }

      {
        room && !yourRole && (
          <div class="panel role-select-panel">
            <h1>{room.name}</h1>
            <p>
              {room.playerCount}/{room.maxPlayers} Players · {room.viewerCount} Viewers
            </p>
            <p id="entry-error" class="form-error" role="alert" hidden />
            <div class="role-dialog-actions">
              <button
                type="button"
                id="entry-join-player"
                class="button primary"
                disabled={room.locked && !room.youAreCreator}
                data-full={room.playerCount >= room.maxPlayers ? "1" : ""}
                data-locked={room.locked && !room.youAreCreator ? "1" : ""}
              >
                Join as Player
              </button>
              <button type="button" id="entry-join-viewer" class="button" disabled={!room.allowViewers}>
                Join as Viewer
              </button>
              <a class="button" href="/arena/">
                Back to Lobby
              </a>
            </div>
          </div>
        )
      }

      {
        room && yourRole && (
          <div class="room-layout" id="room-view" data-room-id={room.id}>
            <div class="room-header">
              <button type="button" id="back-button" class="button back-button" aria-label="Leave this room and go back">
                <span aria-hidden="true">&larr;</span> Back
              </button>
              <h1 class="room-header-title" title={room.name}>
                {room.name}
                {room.locked && (
                  <span class="room-lock-icon" aria-label="Locked: player joining disabled">
                    {" "}
                    🔒
                  </span>
                )}
              </h1>
            </div>

            <div class="room-main">
              <canvas id="board" width="480" height="480" aria-label={`${room.name} game board`} />
              <div class="dpad" role="group" aria-label="Movement controls" hidden={yourRole !== "player"}>
                <div class="dpad-grid">
                  <button type="button" class="dpad-button dpad-up" data-direction="up" aria-label="Move up">
                    &uarr;
                  </button>
                  <button type="button" class="dpad-button dpad-left" data-direction="left" aria-label="Move left">
                    &larr;
                  </button>
                  <button type="button" class="dpad-button dpad-right" data-direction="right" aria-label="Move right">
                    &rarr;
                  </button>
                  <button type="button" class="dpad-button dpad-down" data-direction="down" aria-label="Move down">
                    &darr;
                  </button>
                </div>
              </div>
            </div>

            <div class="room-sidebar">
              <div class="panel room-status-panel">
                <div class="hud-row">
                  <span>Your role</span>
                  <strong id="your-role">{yourRole === "player" ? "Player" : "Viewer"}</strong>
                </div>
                <div class="hud-row">
                  <span>Score</span>
                  <strong id="score">0</strong>
                </div>
                <p id="status-banner" data-status="connecting">
                  Connecting…
                </p>
                <p id="final-score-line" hidden>
                  Final score: <strong id="final-score">0</strong> — already on the{" "}
                  <a href="/leaderboard/">leaderboard</a>.
                </p>

                <div class="room-actions">
                  {
                    !room.locked && (
                      <button type="button" id="role-toggle-button" class="button role-toggle" hidden>
                        <span class="role-toggle-label">Become Viewer</span>
                      </button>
                    )
                  }
                  <button type="button" id="respawn-button" class="button primary" hidden>
                    Respawn
                  </button>
                </div>
                <p id="role-toggle-reason" class="action-reason" hidden />
                <p id="role-action-error" class="form-error" role="alert" hidden />
              </div>

              <div class="panel players-panel">
                <h2 id="players-heading">Players (0/5)</h2>
                <ul id="players-list" />
              </div>
              <div class="panel players-panel">
                <h2 id="viewers-heading">Viewers (0)</h2>
                <ul id="viewers-list" />
              </div>
            </div>
          </div>
        )
      }

      <div id="room-closed-panel" class="panel" role="alert" hidden>
        <h2>Room closed</h2>
        <p id="room-closed-reason"></p>
        <a class="button primary" href="/arena/">
          Back to the Arena Lobby
        </a>
      </div>
    </main>
    <script>
      import { initThemeToggle } from "../../frontend/theme";
      initThemeToggle();
    </script>
    {
      room && !yourRole && (
        <script define:vars={{ roomId }}>
          const joinPlayerButton = document.getElementById("entry-join-player");
          const joinViewerButton = document.getElementById("entry-join-viewer");
          const errorEl = document.getElementById("entry-error");

          async function join(role) {
            errorEl.hidden = true;
            joinPlayerButton.disabled = true;
            joinViewerButton.disabled = true;
            try {
              const res = await fetch(`/api/rooms/${roomId}/join`, {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ role }),
              });
              if (res.ok) {
                window.location.reload();
                return;
              }
              const data = await res.json().catch(() => ({}));
              errorEl.textContent = data.reason ?? "Could not join the room.";
              errorEl.hidden = false;
            } catch {
              errorEl.textContent = "Couldn't reach the server.";
              errorEl.hidden = false;
            } finally {
              joinPlayerButton.disabled = joinPlayerButton.dataset.locked === "1" || joinPlayerButton.dataset.full === "1";
              joinViewerButton.disabled = false;
            }
          }

          joinPlayerButton.addEventListener("click", () => join("player"));
          joinViewerButton.addEventListener("click", () => join("viewer"));
        </script>
      )
    }
    {
      room && yourRole && (
        <script>
          import { attachDpad } from "../../frontend/dpad";
          import { becomePlayer, becomeViewer, createRoomClient, respawn } from "../../frontend/room-client";
          import { computeRoleToggleState } from "../../frontend/room-role-toggle";
          import type { RoomFrame } from "../../lib/room-server";
          import { GRID_SIZE } from "../../game/config";

          const roomView = document.getElementById("room-view") as HTMLElement;
          const roomId = Number(roomView.dataset.roomId);
          const canvas = document.getElementById("board") as HTMLCanvasElement;
          const dpad = document.querySelector<HTMLElement>(".dpad")!;
          const backButton = document.getElementById("back-button") as HTMLButtonElement;
          const scoreEl = document.getElementById("score")!;
          const statusEl = document.getElementById("status-banner")!;
          const yourRoleEl = document.getElementById("your-role")!;
          const playersHeading = document.getElementById("players-heading")!;
          const viewersHeading = document.getElementById("viewers-heading")!;
          const playersList = document.getElementById("players-list")!;
          const viewersList = document.getElementById("viewers-list")!;
          // Absent entirely (not just hidden) for a locked/solo room — see
          // the server-rendered conditional above — so every reference here
          // has to tolerate null rather than assume the element exists.
          const roleToggleButton = document.getElementById("role-toggle-button") as HTMLButtonElement | null;
          const roleToggleLabel = roleToggleButton?.querySelector<HTMLElement>(".role-toggle-label") ?? null;
          const roleToggleReason = document.getElementById("role-toggle-reason")!;
          const respawnButton = document.getElementById("respawn-button") as HTMLButtonElement;
          const roleActionError = document.getElementById("role-action-error")!;
          const finalScoreLine = document.getElementById("final-score-line")!;
          const finalScoreEl = document.getElementById("final-score")!;
          const closedPanel = document.getElementById("room-closed-panel")!;
          const closedReason = document.getElementById("room-closed-reason")!;

          // ---- intentional-departure membership release -------------------
          // See docs/decisions/ADR-003: any of these firing removes this
          // member immediately (no grace window — that's only for an
          // unplanned disconnect). `released` is a same-page, same-tick
          // guard against sending the (already server-side idempotent)
          // signal more than once for one departure; it is not what makes
          // the cleanup correct, just what keeps it polite.
          let released = false;
          function release(): void {
            if (released) return;
            released = true;
            navigator.sendBeacon(`/api/rooms/${roomId}/leave`);
          }
          async function releaseAwaited(): Promise<void> {
            if (released) return;
            released = true;
            try {
              await fetch(`/api/rooms/${roomId}/leave`, {
                method: "POST",
                headers: { "content-type": "application/json" },
                keepalive: true,
              });
            } catch {
              // Best-effort — the disconnect-grace fallback and pagehide's
              // sendBeacon below both still cover this if it fails.
            }
          }

          // Any same-origin link click anywhere on the page (the nav bar's
          // Arena/Leaderboard/About/logo links, the "leaderboard" link in
          // the final-score line, anything else added later) counts as
          // navigating away — one generic rule rather than an enumerated
          // list of specific links. sendBeacon is fire-and-forget by
          // design, so this never delays the click's own navigation.
          document.addEventListener(
            "click",
            (event) => {
              const link = (event.target as HTMLElement).closest("a");
              if (!link || !link.href) return;
              try {
                if (new URL(link.href, location.href).origin === location.origin) release();
              } catch {
                /* not a parseable URL — ignore */
              }
            },
            { capture: true },
          );

          // The best-effort net for refresh/tab-close/history navigation —
          // more reliable than beforeunload (which mobile Safari can skip
          // and which can block the back/forward cache). No awaited fetch
          // here: a `pagehide` handler isn't guaranteed time to await
          // anything before the document actually goes away.
          window.addEventListener("pagehide", release);

          backButton.addEventListener("click", async () => {
            await releaseAwaited();
            let cameFromInApp = false;
            try {
              cameFromInApp = Boolean(document.referrer) && new URL(document.referrer).origin === location.origin;
            } catch {
              cameFromInApp = false;
            }
            if (cameFromInApp && window.history.length > 1) history.back();
            else window.location.href = "/arena/";
          });

          // ---- gameplay/membership wiring (unchanged mechanics) -----------

          // Set for the duration of one role-toggle request — guards against
          // a duplicate submission (the button is also disabled while this
          // is true) and against renderMembers flipping the label back to
          // the pre-click role on a frame that hasn't caught up yet. Cleared
          // once the request settles either way; the next frame (success or
          // not) then redraws the button from whatever the server actually
          // did, never from a client-side guess.
          let rolePending = false;

          function showActionError(reason: string | undefined): void {
            roleActionError.textContent = reason ?? "That action couldn't be completed.";
            roleActionError.hidden = false;
          }

          function renderMembers(frame: RoomFrame): void {
            const players = frame.members.filter((m) => m.role === "player");
            const viewers = frame.members.filter((m) => m.role === "viewer");
            playersHeading.textContent = `Players (${players.length}/5)`;
            viewersHeading.textContent = `Viewers (${viewers.length})`;

            const renderList = (list: HTMLElement, members: typeof players) => {
              list.replaceChildren(
                ...members.map((m) => {
                  const li = document.createElement("li");
                  const label = document.createElement("span");
                  label.title = m.displayName;
                  label.textContent = `${m.displayName}${m.isMine ? " (you)" : ""}${m.connected ? "" : " (reconnecting…)"}`;
                  li.append(label);
                  return li;
                }),
              );
            };
            renderList(playersList, players);
            renderList(viewersList, viewers);

            const amIEliminated = frame.yourRole === "player" && !frame.arena.snakes.some((s) => s.isMine);
            const playerFull = players.length >= 5;

            respawnButton.hidden = !(frame.yourRole === "player" && amIEliminated);

            // Absent entirely for a locked room (see the conditional in the
            // markup above) — nothing to render in that case. While a
            // request is in flight, leave the button exactly as the click
            // handler set it rather than letting this frame (still showing
            // the pre-switch role) flip it back.
            if (roleToggleButton && roleToggleLabel && !rolePending) {
              const state = computeRoleToggleState({
                locked: frame.room.locked,
                yourRole: frame.yourRole,
                playerCount: players.length,
              });
              roleToggleButton.hidden = state.hidden;
              roleToggleButton.dataset.targetRole = state.targetRole;
              roleToggleLabel.textContent = state.label;
              roleToggleButton.disabled = state.disabled;
              roleToggleReason.hidden = state.reason === "";
              roleToggleReason.textContent = state.reason;
            }

            respawnButton.disabled = playerFull && !frame.members.some((m) => m.isMine);
            finalScoreLine.hidden = !(frame.yourRole === "player" && amIEliminated);
            yourRoleEl.textContent = frame.yourRole === "player" ? "Player" : "Viewer";
          }

          function onFrame(frame: RoomFrame): void {
            roleActionError.hidden = true;
            const eliminated = frame.yourRole === "player" && !frame.arena.snakes.some((s) => s.isMine);
            statusEl.textContent = eliminated ? "Eliminated" : "Playing";
            statusEl.dataset.status = eliminated ? "eliminated" : "playing";
            const mine = frame.arena.snakes.find((s) => s.isMine);
            scoreEl.textContent = String(mine?.score ?? 0);
            renderMembers(frame);
          }

          function onEliminated(finalScore: number): void {
            finalScoreEl.textContent = String(finalScore);
          }

          // A brief opportunity to actually read the reason (ADR-004) before
          // this Viewer is sent back to the lobby automatically — the panel
          // and its own "Back to the Arena Lobby" link stay as a fallback
          // for anyone who navigates away before the timer fires.
          const CLOSED_REDIRECT_MS = 4000;

          function onClosed(reason: string): void {
            roomView.hidden = true;
            closedPanel.hidden = false;
            closedReason.textContent = reason;
            setTimeout(() => {
              window.location.href = "/arena/";
            }, CLOSED_REDIRECT_MS);
          }

          const client = createRoomClient({
            roomId,
            canvas,
            cellPx: canvas.width / GRID_SIZE,
            onFrame,
            onEliminated,
            onClosed,
          });
          const detachDpad = attachDpad(dpad, client.sendDirection);

          roleToggleButton?.addEventListener("click", async () => {
            if (rolePending) return;
            rolePending = true;
            roleToggleButton.disabled = true;
            roleActionError.hidden = true;
            const targetRole = roleToggleButton.dataset.targetRole;
            const result = targetRole === "player" ? await becomePlayer(roomId) : await becomeViewer(roomId);
            rolePending = false;
            if (!result.ok) showActionError(result.reason);
            // Whether this succeeded or was rejected, the next SSE frame
            // (already on its way — the room's tick loop broadcasts well
            // under a second from now) redraws the button from authoritative
            // state; this handler never sets the label itself.
          });
          respawnButton.addEventListener("click", async () => {
            respawnButton.disabled = true;
            await respawn(roomId);
            respawnButton.disabled = false;
          });

          window.addEventListener("pagehide", () => {
            client.stop();
            detachDpad();
          });
        </script>
      )
    }
  </body>
</html>
